<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- sfondo semi trasparente -->
    <solid android:color="#B8B4B4B4"/>

    <!-- angoli arrotondati -->
    <corners android:radius="17dp"/>

    <!-- bordo leggero -->
    <stroke
        android:width="2dp"
        android:color="#66B4B4B4"/>

    <!-- padding interno -->
    <padding
        android:left="20dp"
        android:top="12dp"
        android:right="20dp"
        android:bottom="12dp"/>
</shape>